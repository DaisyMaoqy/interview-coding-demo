// 审批工作流库（approval_workflow_db）数据模型
//
// MySQL 8 兼容要点（对照 backend/docs/API-ALIGNMENT.md §6）：
// 1. MySQL 8 不支持 Prisma native enum，`enum {}` 改为 `String` + 应用层校验。
// 2. datasource 使用 env("AWS_DATABASE_URL")，模型落入 approval-workflow 子客户端。
// 3. 不在本库存完整 User；applicantId/actorId 等用普通 String 逻辑外键，不建 DB 级 FK。
// 4. 金额用 Decimal(15,2) 原样存「分」值，不做元/分换算，避免精度漂移。

datasource db {
  provider = "mysql"
  url      = env("AWS_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// 申请单主表（差旅 / 请假共用一表，按 type 区分）
model Request {
  id            String   @id
  type          String // 'travel' | 'leave'
  status        String // RequestStatus: draft|pending_manager|pending_finance|approved|rejected|cancelled
  applicantId   String
  applicantName String
  department    String

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?

  // —— 差旅字段 ——
  reason  String // 10~200 字（travel）/ 5~200 字（leave），统一 String 存储
  urgency String? // 'normal' | 'urgent'

  // —— 请假字段 ——
  leaveType String? // 'annual' | 'sick' | 'personal'
  leaveStart String? // YYYY-MM-DD
  leaveEnd  String? // YYYY-MM-DD
  note      String? // ≤200

  legs    TripLeg[]
  budgets Budget[]
  audit   AuditEntry[]

  @@index([applicantId])
  @@index([status])
  @@index([type])
  @@index([department])
  @@index([createdAt])
}

/// 差旅行程段（1~10 段）
model TripLeg {
  id         String  @id @default(cuid())
  requestId  String
  request    Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  from       String // ≤30
  to         String // ≤30
  departDate String // YYYY-MM-DD
  returnDate String // YYYY-MM-DD
  transport  String // 'train' | 'flight' | 'car' | 'other'
  sortOrder  Int    @default(0)

  @@index([requestId])
}

/// 差旅预算（分，Decimal 落库）
model Budget {
  id         String  @id @default(cuid())
  requestId  String
  request    Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  transport  Decimal @db.Decimal(15, 2)
  hotel      Decimal @db.Decimal(15, 2)
  allowance  Decimal @db.Decimal(15, 2)
  other      Decimal @db.Decimal(15, 2)
  budgetNote String? // 预算合计 > 1_000_000 分时必填；≤200 字

  @@index([requestId])
}

/// 审批轨迹（提交 / 审批 / 驳回 / 撤回 / 重新编辑）
model AuditEntry {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())
  actorId   String
  actorName String
  action    String // 'submit' | 'approve' | 'reject' | 'cancel' | 'reedit'
  from      String // 流转前状态
  to        String // 流转后状态
  comment   String? // ≤200

  @@index([requestId])
}
